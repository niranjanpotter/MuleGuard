{
  "name": "muleguard",
  "displayName": "MuleGuard -- MuleSoft Code Review",
  "description": "Real-time linting, security scanning, connector & DataWeave hover intelligence, and structured code review for MuleSoft Mule 4 applications.",
  "version": "1.1.0",
  "publisher": "niranjanpotter",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niranjanpotter/MuleGuard.git"
  },
  "bugs": {
    "url": "https://github.com/niranjanpotter/MuleGuard/issues"
  },
  "homepage": "https://github.com/niranjanpotter/MuleGuard#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "mulesoft",
    "mule",
    "mule4",
    "dataweave",
    "dwl",
    "linter",
    "security",
    "compliance",
    "guardrails",
    "munit"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml",
    "onLanguage:dataweave",
    "workspaceContains:**/*.xml",
    "workspaceContains:**/*.dwl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dataweave",
        "aliases": [
          "DataWeave",
          "dataweave",
          "dwl"
        ],
        "extensions": [
          ".dwl"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dataweave",
        "scopeName": "source.dataweave",
        "path": "./syntaxes/dataweave.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xml",
        "path": "./snippets/mule-xml.json"
      },
      {
        "language": "dataweave",
        "path": "./snippets/dataweave.json"
      }
    ],
    "commands": [
      {
        "command": "muleguard.scanWorkspace",
        "title": "MuleGuard: Scan Workspace",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.fixAll",
        "title": "MuleGuard: Fix All Auto-Fixable Issues",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.runCodeReview",
        "title": "MuleGuard: Run 7-Step Code Review Audit",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.visualizeFlow",
        "title": "MuleGuard: Visualize Mule Flow",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.diffEnvConfigs",
        "title": "MuleGuard: Compare Environment Configs (YAML Diff)",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.scanSecrets",
        "title": "MuleGuard: Scan Workspace for Hardcoded Secrets",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.showComplexityMetrics",
        "title": "MuleGuard: Calculate Flow Complexity Metrics",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.showExecutiveDashboard",
        "title": "MuleGuard: Open Executive Architecture & Delivery Review Dashboard",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.explainDataWeave",
        "title": "MuleGuard: Explain DataWeave File Logic",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.refreshFlowExplorer",
        "title": "MuleGuard: Refresh Flow Explorer",
        "category": "MuleGuard",
        "icon": "$(refresh)"
      },
      {
        "command": "muleguard.createBaseline",
        "title": "MuleGuard: Create Diagnostic Baseline (.muleguard-baseline.json)",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.compareDwlAcrossEnvs",
        "title": "Compare Across Environments",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.generateFlowDocs",
        "title": "MuleGuard: Generate Flow Documentation (docs/flows.md)",
        "category": "MuleGuard"
      },
      {
        "command": "muleguard.generateBadge",
        "title": "MuleGuard: Generate Health Score Badge (muleguard-score.svg)",
        "category": "MuleGuard"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "muleguard.compareDwlAcrossEnvs",
          "when": "view == muleguardFlowExplorer && viewItem == dwl",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "muleguard-sidebar",
          "title": "MuleGuard",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "muleguard-sidebar": [
        {
          "id": "muleguardFlowExplorer",
          "name": "Mule Project Explorer"
        }
      ]
    },
    "keybindings": [
      {
        "command": "muleguard.runCodeReview",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "muleguard.scanWorkspace",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "muleguard.visualizeFlow",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == xml"
      }
    ],
    "walkthroughs": [
      {
        "id": "muleguard.welcome",
        "title": "Welcome to MuleGuard",
        "description": "Start building secure, high-performance MuleSoft APIs with real-time linting, connector hovers, and full code review.",
        "steps": [
          {
            "id": "muleguard.step1",
            "title": "Real-time Linting & Quality Guardrails",
            "description": "Open any Mule XML or DataWeave file. MuleGuard immediately displays inline squiggles for hardcoded credentials, missing error handlers, log levels, and performance antipatterns.",
            "media": { "markdown": "README.md" }
          },
          {
            "id": "muleguard.step2",
            "title": "Connector Intelligence & Hover Tooltips",
            "description": "Hover over any Mule connector (<http:request>, <db:select>, <ee:transform>) to see human-readable explanations, runtime execution models, and Anypoint doc links.",
            "media": { "markdown": "README.md" }
          },
          {
            "id": "muleguard.step3",
            "title": "Run 7-Step Code Review",
            "description": "Press `Ctrl+Shift+M` or open Command Palette and run `MuleGuard: Run 7-Step Code Review Audit` to generate an enterprise `code-review-report.md` covering all 45 checklist rules.",
            "media": { "markdown": "README.md" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "MuleGuard Pro",
      "properties": {
        "muleguard.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable MuleGuard Pro static analysis diagnostics for Mule XML and DataWeave (.dwl) files."
        },
        "muleguard.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable connector hover tooltips with human-readable logic and Anypoint documentation links."
        },
        "muleguard.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/src/test/**", "**/target/**", "**/.mule/**", "**/.tooling-project/**", "**/node_modules/**", "**/out/**", "**/dist/**", "**/.git/**"],
          "description": "Glob patterns excluded from MuleGuard workspace scanning."
        },
        "muleguard.secretProviders": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["secure::", "aws-secrets::", "aws-s3::"],
          "description": "Known-safe property provider prefixes recognized by secret scanning rules."
        },
        "muleguard.naming.ignorePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["^(get|post|put|patch|delete|head|options):\\\\", "-main$"],
          "description": "Regex patterns ignored by BP-01 flow naming checks (e.g. APIkit routes)."
        },
        "muleguard.logging.acceptedFlows": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["mule-logging-utilFlow", "*-logger", "*logging*"],
          "description": "Flow-ref name patterns accepted as satisfying MG003 start-of-flow logging."
        },
        "muleguard.dataweave.nullSafety.minDepth": {
          "type": "number",
          "default": 3,
          "description": "Minimum member-access depth before MG006 flags unguarded DataWeave navigation."
        },
        "muleguard.dataweave.nullSafety.maxPerFile": {
          "type": "number",
          "default": 20,
          "description": "Maximum MG006 diagnostics emitted per file before summarizing remaining findings."
        },
        "muleguard.environments": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["dev", "development", "test", "qa", "sit", "uat", "tlb", "sandbox", "stage", "staging", "prod", "production", "local"],
          "description": "Environment folder and config name segments used for grouping and sorting."
        },
        "muleguard.referenceEnvironment": {
          "type": "string",
          "default": "production",
          "description": "Reference environment used when comparing DataWeave files and configs across environments."
        },
        "muleguard.lint.fixtures": {
          "type": "boolean",
          "default": false,
          "description": "Whether to lint test fixture .dwl payloads with MG006."
        },
        "muleguard.baseline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Filter out findings recorded in .muleguard-baseline.json when present."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
